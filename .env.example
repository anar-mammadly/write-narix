# Supabase (get these from your Supabase project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_, never import from client components.
SUPABASE_SERVICE_ROLE_KEY=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL="Narix Academy <orders@writing.narix.az>"

# Used to build absolute links in emails and to build tracking/claim URLs
NEXT_PUBLIC_SITE_URL=https://writing.narix.az

# Shared secret required in the Authorization header when the background
# email-outbox worker route is invoked (by a Supabase Edge Function / cron).
CRON_SECRET=
